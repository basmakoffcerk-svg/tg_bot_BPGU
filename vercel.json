{
  "version": 2,
  "functions": {
    "api/index.py": {
      "runtime": "python3.12"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },

    {
      "source": "/webapp/(.*)",
      "destination": "/webapp/$1"
    },
    {
      "source": "/",
      "destination": "/webapp/index.html"
    },
    {
      "source": "/((?!api|webapp).*)",
      "destination": "/webapp/$1"
    }
  ]
}
