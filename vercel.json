{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },

    {
      "source": "/webapp/(.*)",
      "destination": "/webapp/$1"
    },
    {
      "source": "/",
      "destination": "/webapp/index.html"
    },
    {
      "source": "/((?!api|webapp).*)",
      "destination": "/webapp/$1"
    }
  ]
}

