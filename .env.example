# ==========================================
# ОСНОВНЫЕ НАСТРОЙКИ TELEGRAM
# ==========================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_12345678
STAROSTA_TELEGRAM_ID=123456789
GROUP_CHAT_ID=-1001234567890

# ==========================================
# НАСТРОЙКИ СЕРВЕРА
# ==========================================
HOST=0.0.0.0
PORT=8000
APP_ENV=development
TIMEZONE=Europe/Moscow

# URL вебхука бота (если используется Webhook)
WEBHOOK_URL=https://api.yourdomain.com/webhook
WEBHOOK_SECRET=your_super_secret_webhook_token

# URL фронтенда Telegram Mini App (для CORS и Menu Button)
FRONTEND_URL=https://app.yourdomain.com

# ==========================================
# БАЗА ДАННЫХ
# ==========================================
DATABASE_URL=sqlite+aiosqlite:///data/database.sqlite
BACKUP_DIR=data/backups

# ==========================================
# ПАРАМЕТРЫ ГЕОЧЕКИНА
# ==========================================
MAX_ALLOWED_DISTANCE_METERS=150
MAX_GPS_ACCURACY_METERS=50
CHECKIN_WINDOW_BEFORE_MINUTES=5
CHECKIN_WINDOW_AFTER_MINUTES=15
